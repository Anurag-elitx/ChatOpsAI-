# ── Application ──────────────────────────────────
ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database ─────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=vectordb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── External Services ────────────────────────────
SENTRY_DSN=
SLACK_API_TOKEN=
CLOUD_API_KEY=

# ── Integration Endpoints ────────────────────────
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
SALESFORCE_BASE_URL=https://login.salesforce.com
ZENDESK_BASE_URL=https://your-subdomain.zendesk.com
API_TIMEOUT_SECONDS=30

# ── Model Config ─────────────────────────────────
INTENT_MODEL_NAME=bhadresh-savani/distilbert-base-uncased-emotion
GENERATION_MODEL_NAME=gpt2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
VECTOR_SEARCH_TOP_K=3
GENERATION_MAX_TOKENS=100

# ── Vector Store Paths ───────────────────────────
FAISS_INDEX_PATH=vector_store/index.faiss
ID_TO_TEXT_PATH=vector_store/id_to_text.json
